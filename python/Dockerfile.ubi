# --------------------------------------------------------------------------
# TokenSpeed — GPU-accelerated LLM inference engine
# Multi-stage Dockerfile for OpenShift (CUDA + UBI9)
# --------------------------------------------------------------------------
# Build context: repo root (/workspace/tokenspeed)
# Build command:  podman build -f python/Dockerfile.ubi .
# --------------------------------------------------------------------------
#
# Build fix history:
#   1. Original single-stage build exhausted disk during pip install.
#   2. Multi-stage build still blew up because --extra-index-url caused pip
#      to pull torch from PyPI, which bundles ~3 GB of nvidia-* CUDA libs
#      that are ALREADY present in the CUDA base image.
#   3. Fix: Use --index-url (not --extra-index-url) for torch to get the
#      cu126 wheel that links against system CUDA and does NOT bundle
#      nvidia-cublas, nvidia-cudnn, nvidia-nccl, etc.  Then install the
#      remaining Python deps from PyPI in a separate pip call.
# --------------------------------------------------------------------------

# ========================  STAGE 1: Builder  ========================
FROM nvcr.io/nvidia/cuda:12.6.3-devel-ubi9 AS builder

USER 0

# System build dependencies
RUN dnf install -y \
        python3.12 \
        python3.12-pip \
        python3.12-devel \
        gcc \
        gcc-c++ \
        git \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/cache/yum

# Set up python alternatives
RUN alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && alternatives --install /usr/bin/python  python  /usr/bin/python3.12 1

# Create a virtual environment for clean COPY to runtime stage
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv ${VIRTUAL_ENV}
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"
ENV PIP_NO_CACHE_DIR=1

RUN pip install --upgrade pip setuptools wheel

# ---------- Install PyTorch from CUDA-specific index ----------
# CRITICAL: Use --index-url (NOT --extra-index-url).
# The cu126 index provides a torch wheel (~830 MB) that links against the
# system CUDA libraries already present in the base image, instead of
# bundling ~3 GB of nvidia-cublas-cu12, nvidia-cudnn-cu12, nvidia-nccl-cu12,
# etc. as pip dependencies.  This is the key fix for the disk-space blow-up.
RUN pip install --no-cache-dir \
        "torch==2.11.0" \
        --index-url https://download.pytorch.org/whl/cu126

# ---------- Install triton separately (large wheel, own layer for caching) ----------
RUN pip install --no-cache-dir triton

# ---------- Install remaining Python deps from PyPI ----------
# Omitting heavy optional packages not required for core serving:
#   torchvision, viztracer, py-spy, ninja, nvidia-cutlass-dsl, uv
RUN pip install --no-cache-dir \
        "transformers==5.6.2" \
        huggingface_hub \
        hf_transfer \
        peft \
        tiktoken \
        compressed-tensors \
        einops \
        numpy \
        fastapi \
        uvicorn \
        uvloop \
        aiohttp \
        "openai==2.33.0" \
        openai-harmony \
        orjson \
        msgspec \
        pydantic \
        python-multipart \
        prometheus-client \
        dill \
        modelscope \
        nvtx \
        packaging \
        partial-json-parser \
        pillow \
        psutil \
        pybase64 \
        pybind11 \
        pyzmq \
        requests \
        setproctitle \
        tqdm \
        "xgrammar==0.1.33"

# ---------- Install tokenspeed package ----------
WORKDIR /opt/app-root/src
COPY python/pyproject.toml python/LICENSE python/THIRDPARTYNOTICES ./python/
COPY python/tokenspeed ./python/tokenspeed

RUN cd python \
    && pip install --no-cache-dir --no-deps --no-build-isolation .

# ---------- Strip caches / tests from venv to shrink copy size ----------
RUN find ${VIRTUAL_ENV} -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true \
    && find ${VIRTUAL_ENV} -type d -name 'tests' -path '*/torch/*' -exec rm -rf {} + 2>/dev/null || true \
    && find ${VIRTUAL_ENV} -type d -name '*.dist-info' -exec sh -c 'rm -rf "$1"/RECORD "$1"/SOURCES.txt "$1"/top_level.txt 2>/dev/null' _ {} \; 2>/dev/null || true \
    && rm -rf /root/.cache /tmp/pip-*


# ========================  STAGE 2: Runtime  ========================
FROM nvcr.io/nvidia/cuda:12.6.3-runtime-ubi9

USER 0

# Minimal runtime system packages (no compiler toolchain)
RUN dnf install -y \
        python3.12 \
        libibverbs \
        librdmacm \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/cache/yum \
    && alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && alternatives --install /usr/bin/python  python  /usr/bin/python3.12 1

# Copy the entire virtual environment from the builder
ENV VIRTUAL_ENV=/opt/venv
COPY --from=builder ${VIRTUAL_ENV} ${VIRTUAL_ENV}
ENV PATH="${VIRTUAL_ENV}/bin:${PATH}"

# Copy application source
WORKDIR /opt/app-root/src
COPY --from=builder /opt/app-root/src/python ./python

# Ensure tokenspeed package is importable from WORKDIR/python
ENV PYTHONPATH=/opt/app-root/src/python:${PYTHONPATH}

# ---------- Light verification (no torch import — avoids CUDA init) ----------
RUN python3 -c "import uvicorn; import fastapi; print('Server deps OK')" \
    && python3 -c "from tokenspeed.version import __version__; print(f'TokenSpeed v{__version__}')"

# ---------- Environment variables ----------
# HF_TOKEN must be injected at runtime via K8s Secret / ConfigMap
ENV HF_TOKEN=""
ENV TOKENSPEED_MODEL=meta-llama/Llama-3.2-1B-Instruct
ENV TOKENSPEED_HOST=0.0.0.0
ENV TOKENSPEED_PORT=8000

# HuggingFace cache — mount a PVC here for persistent model weights
ENV HF_HOME=/opt/app-root/src/.cache/huggingface
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# CUDA runtime
ENV CUDA_HOME=/usr/local/cuda
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ---------- OpenShift compatibility ----------
# Writable cache dir; group-0 perms for arbitrary UID
RUN mkdir -p /opt/app-root/src/.cache/huggingface \
    && chgrp -R 0 /opt/app-root \
    && chmod -R g=u /opt/app-root

EXPOSE 8000

USER 1001

# Shell form so env vars are expanded at runtime
CMD exec python3 -m tokenspeed.cli serve \
    --model ${TOKENSPEED_MODEL} \
    --host ${TOKENSPEED_HOST} \
    --port ${TOKENSPEED_PORT}
