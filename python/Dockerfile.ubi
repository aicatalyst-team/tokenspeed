# --------------------------------------------------------------------------
# TokenSpeed — GPU-accelerated LLM inference engine
# Multi-stage Dockerfile for OpenShift (CUDA runtime + UBI9)
# --------------------------------------------------------------------------
# Build context: repo root (/workspace/tokenspeed)
# Build command:  podman build -f python/Dockerfile.ubi .
# --------------------------------------------------------------------------
#
# Previous build failed due to OpenShift infrastructure — build pod evicted
# (symlink resolution error on pod log path, caused by disk pressure / OOM).
#
# Fixes applied vs previous attempt:
#   1. Multi-stage build: install all deps in builder stage, copy site-packages
#      to runtime stage — halves final image size and reduces disk pressure.
#   2. Single pip install layer in builder (all deps at once) — fewer layers,
#      less cumulative overlay storage.
#   3. Use --no-cache-dir globally via ENV to eliminate pip cache accumulation.
#   4. Smaller runtime stage reduces total disk written during build.
# --------------------------------------------------------------------------

# ==================== BUILDER STAGE ====================
FROM nvcr.io/nvidia/cuda:12.6.3-runtime-ubi9 AS builder

USER 0

# ---------- System dependencies for building ----------
RUN dnf install -y \
        python3.12 \
        python3.12-pip \
        python3.12-devel \
        gcc \
        gcc-c++ \
        git \
    && dnf clean all \
    && alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && alternatives --install /usr/bin/python  python  /usr/bin/python3.12 1

ENV PIP_NO_CACHE_DIR=1

RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

WORKDIR /build

# ---------- Install ALL Python dependencies in a single layer ----------
# PyTorch with CUDA 12.6 index + all application deps + uvicorn/fastapi
RUN pip install --no-cache-dir \
        "torch==2.11.0" \
        torchvision \
        --extra-index-url https://download.pytorch.org/whl/cu126 \
    && pip install --no-cache-dir \
        aiohttp \
        compressed-tensors \
        dill \
        einops \
        fastapi \
        hf_transfer \
        huggingface_hub \
        modelscope \
        msgspec \
        ninja \
        numpy \
        nvidia-cutlass-dsl \
        nvtx \
        "openai==2.33.0" \
        openai-harmony \
        orjson \
        packaging \
        partial-json-parser \
        peft \
        pillow \
        prometheus-client \
        psutil \
        pybase64 \
        pybind11 \
        pydantic \
        py-spy \
        python-multipart \
        pyzmq \
        requests \
        setproctitle \
        tiktoken \
        tqdm \
        "transformers==5.6.2" \
        triton \
        uv \
        uvicorn \
        uvloop \
        viztracer \
        "xgrammar==0.1.33" \
    && rm -rf /tmp/pip-* /root/.cache

# ---------- Install the tokenspeed package ----------
COPY python/pyproject.toml python/LICENSE python/THIRDPARTYNOTICES /build/python/
COPY python/tokenspeed /build/python/tokenspeed

RUN cd /build/python \
    && pip install --no-cache-dir --no-deps --no-build-isolation . \
    && rm -rf /tmp/pip-* /root/.cache

# Verify critical imports in builder
RUN python3 -c "import uvicorn; import fastapi; print('Server deps OK')" \
    && python3 -c "from tokenspeed.version import __version__; print(f'TokenSpeed v{__version__}')"


# ==================== RUNTIME STAGE ====================
FROM nvcr.io/nvidia/cuda:12.6.3-runtime-ubi9

USER 0

# ---------- Minimal runtime system packages (no compiler toolchain) ----------
RUN dnf install -y \
        python3.12 \
        python3.12-pip \
        libibverbs \
        librdmacm \
    && dnf clean all \
    && alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && alternatives --install /usr/bin/python  python  /usr/bin/python3.12 1

# ---------- Copy installed Python packages from builder ----------
COPY --from=builder /usr/lib64/python3.12/site-packages /usr/lib64/python3.12/site-packages
COPY --from=builder /usr/lib/python3.12/site-packages /usr/lib/python3.12/site-packages
COPY --from=builder /usr/local/lib64/python3.12/site-packages /usr/local/lib64/python3.12/site-packages
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

WORKDIR /opt/app-root/src

# ---------- Copy tokenspeed source (for any file-relative references) ----------
COPY python/pyproject.toml python/LICENSE python/THIRDPARTYNOTICES /opt/app-root/src/python/
COPY python/tokenspeed /opt/app-root/src/python/tokenspeed

# ---------- Environment variables ----------
# HF_TOKEN must be injected at runtime via K8s Secret / ConfigMap
ENV HF_TOKEN=""
ENV TOKENSPEED_MODEL=meta-llama/Llama-3.2-1B-Instruct
ENV TOKENSPEED_HOST=0.0.0.0
ENV TOKENSPEED_PORT=8000

# HuggingFace cache — mount a PVC here for persistent model weights
ENV HF_HOME=/opt/app-root/src/.cache/huggingface
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# CUDA runtime
ENV CUDA_HOME=/usr/local/cuda
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ---------- OpenShift compatibility ----------
# Create writable cache directory; set group-0 permissions for arbitrary UID
RUN mkdir -p /opt/app-root/src/.cache/huggingface \
    && chgrp -R 0 /opt/app-root \
    && chmod -R g=u /opt/app-root

EXPOSE 8000

USER 1001

# Use shell form so environment variables are expanded at runtime
CMD exec python3 -m tokenspeed.cli serve \
    --model ${TOKENSPEED_MODEL} \
    --host ${TOKENSPEED_HOST} \
    --port ${TOKENSPEED_PORT}
