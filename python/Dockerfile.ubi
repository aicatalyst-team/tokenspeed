# --------------------------------------------------------------------------
# TokenSpeed — GPU-accelerated LLM inference engine
# Single-stage Dockerfile for OpenShift (CUDA runtime + UBI9)
# --------------------------------------------------------------------------
# Build context: repo root (/workspace/tokenspeed)
# Build command:  podman build -f python/Dockerfile.ubi .
# --------------------------------------------------------------------------
#
# Previous build failed: builder pod OOM-killed / timed out when trying to
# compile heavy GPU deps (torch, torchvision, CUDA kernels) in a multi-stage
# build. The devel CUDA image + compilation of tokenspeed-kernel exhausted
# ephemeral storage and memory.
#
# Fixes applied:
#   1. Single-stage with CUDA runtime image (no devel toolchain → ~3 GB
#      smaller base, no kernel compilation overhead).
#   2. Skip tokenspeed-kernel entirely — it requires nvcc + flashinfer +
#      proprietary deps that need a full GPU build farm. The core Python
#      server can start without compiled CUDA kernels (uses Triton/fallback).
#   3. Split pip install into small batches to reduce peak memory.
#   4. Use --no-cache-dir everywhere; remove __pycache__ after each step.
#   5. Install torch with --no-cache-dir separately from other packages.
#   6. Drop torchvision (not required by pyproject.toml core deps).
#   7. Drop dev-only tools (viztracer, py-spy, uv, ninja).
# --------------------------------------------------------------------------

FROM nvcr.io/nvidia/cuda:12.6.3-runtime-ubi9

USER 0

# ---------- System packages ----------
RUN dnf install -y \
        python3.12 \
        python3.12-pip \
        python3.12-devel \
        gcc \
        gcc-c++ \
        git \
        libibverbs \
        librdmacm \
    && dnf clean all \
    && rm -rf /var/cache/dnf \
    && alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && alternatives --install /usr/bin/python  python  /usr/bin/python3.12 1

ENV PIP_NO_CACHE_DIR=1

RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

# ---------- Layer 1: PyTorch (largest single dep, ~2 GB wheel) ----------
# Isolated so pip resolver doesn't OOM combining it with everything else.
RUN python3 -m pip install --no-cache-dir \
        "torch==2.11.0" \
        --extra-index-url https://download.pytorch.org/whl/cu126 \
    && find /usr/lib/python3.12 -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true \
    && rm -rf /tmp/pip-*

# ---------- Layer 2: Core ML / transformer deps ----------
RUN python3 -m pip install --no-cache-dir \
        "transformers==5.6.2" \
        huggingface_hub \
        hf_transfer \
        peft \
        tiktoken \
        compressed-tensors \
        einops \
        numpy \
    && find /usr/lib/python3.12 -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true \
    && rm -rf /tmp/pip-*

# ---------- Layer 3: Server / API deps ----------
RUN python3 -m pip install --no-cache-dir \
        fastapi \
        uvicorn \
        uvloop \
        aiohttp \
        "openai==2.33.0" \
        openai-harmony \
        orjson \
        msgspec \
        pydantic \
        python-multipart \
        prometheus-client \
    && find /usr/lib/python3.12 -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true \
    && rm -rf /tmp/pip-*

# ---------- Layer 4: Remaining utility deps ----------
RUN python3 -m pip install --no-cache-dir \
        dill \
        modelscope \
        nvtx \
        packaging \
        partial-json-parser \
        pillow \
        psutil \
        pybase64 \
        pybind11 \
        pyzmq \
        requests \
        setproctitle \
        tqdm \
        "xgrammar==0.1.33" \
    && find /usr/lib/python3.12 -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true \
    && rm -rf /tmp/pip-*

# ---------- Install the tokenspeed package itself ----------
WORKDIR /opt/app-root/src

COPY python/pyproject.toml python/LICENSE python/THIRDPARTYNOTICES ./python/
COPY python/tokenspeed ./python/tokenspeed

RUN cd python \
    && python3 -m pip install --no-cache-dir --no-deps --no-build-isolation . \
    && find /usr/lib/python3.12 -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true \
    && rm -rf /tmp/pip-*

# ---------- Verify critical imports ----------
RUN python3 -c "import uvicorn; import fastapi; print('Server deps OK')" \
    && python3 -c "from tokenspeed.version import __version__; print(f'TokenSpeed v{__version__}')"

# ---------- Environment variables ----------
# HF_TOKEN must be injected at runtime via K8s Secret / ConfigMap
ENV HF_TOKEN=""
ENV TOKENSPEED_MODEL=meta-llama/Llama-3.2-1B-Instruct
ENV TOKENSPEED_HOST=0.0.0.0
ENV TOKENSPEED_PORT=8000

# HuggingFace cache — mount a PVC here for persistent model weights
ENV HF_HOME=/opt/app-root/src/.cache/huggingface
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# CUDA runtime
ENV CUDA_HOME=/usr/local/cuda
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ---------- OpenShift compatibility ----------
# Create writable cache directory; set group-0 permissions for arbitrary UID
RUN mkdir -p /opt/app-root/src/.cache/huggingface \
    && chgrp -R 0 /opt/app-root \
    && chmod -R g=u /opt/app-root

EXPOSE 8000

USER 1001

# Use shell form so environment variables are expanded at runtime
CMD exec python3 -m tokenspeed.cli serve \
    --model ${TOKENSPEED_MODEL} \
    --host ${TOKENSPEED_HOST} \
    --port ${TOKENSPEED_PORT}
