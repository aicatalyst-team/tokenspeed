# --------------------------------------------------------------------------
# TokenSpeed — GPU-accelerated LLM inference engine
# Single-stage Dockerfile for OpenShift (CUDA runtime + UBI9)
# --------------------------------------------------------------------------
# Build context: repo root (/workspace/tokenspeed)
# Build command:  docker build -f python/Dockerfile.ubi .
# --------------------------------------------------------------------------
#
# Previous build crashed CRI-O pods (OOM / resource exhaustion) because the
# multi-stage approach pulled the 10 GB+ cuda:devel image and compiled many
# CUDA kernel extensions in-container. This simplified single-stage build:
#   - Uses the CUDA *runtime* image (much smaller, no nvcc/toolkit)
#   - Installs the core tokenspeed Python package only (no native kernels)
#   - Skips tokenspeed-kernel, tokenspeed-mla, tokenspeed-scheduler
#     (optional C/CUDA extensions that require devel toolkit to compile)
#   - The server will start with pure-Python / Triton attention backends
# --------------------------------------------------------------------------

FROM nvcr.io/nvidia/cuda:12.6.3-runtime-ubi9

USER 0

# ---------- System dependencies ----------
RUN dnf install -y \
        python3.12 \
        python3.12-pip \
        python3.12-devel \
        gcc \
        gcc-c++ \
        git \
        libibverbs \
        librdmacm \
    && dnf clean all \
    && alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && alternatives --install /usr/bin/python  python  /usr/bin/python3.12 1

# Upgrade pip / setuptools
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

WORKDIR /opt/app-root/src

# ---------- Install PyTorch with CUDA support (layer-cached) ----------
# Install torch separately so the large wheel is cached independently.
# Use --extra-index-url so other packages still resolve from PyPI.
RUN pip install --no-cache-dir \
        "torch==2.11.0" \
        --extra-index-url https://download.pytorch.org/whl/cu126

# ---------- Copy and install the main tokenspeed Python package ----------
COPY python/pyproject.toml python/LICENSE python/THIRDPARTYNOTICES /opt/app-root/src/python/
COPY python/tokenspeed /opt/app-root/src/python/tokenspeed

RUN cd /opt/app-root/src/python \
    && pip install --no-cache-dir . --no-build-isolation

# ---------- Ensure CLI entrypoint tools are installed ----------
# uvicorn and fastapi are in pyproject.toml dependencies, but verify
RUN python3 -c "import uvicorn; import fastapi; print('Server deps OK')"

# Verify the CLI is importable
RUN python3 -c "from tokenspeed.version import __version__; print(f'TokenSpeed v{__version__}')"

# ---------- Environment variables ----------
# HF_TOKEN must be injected at runtime via K8s Secret / ConfigMap
ENV HF_TOKEN=""
ENV TOKENSPEED_MODEL=meta-llama/Llama-3.2-1B-Instruct
ENV TOKENSPEED_HOST=0.0.0.0
ENV TOKENSPEED_PORT=8000

# HuggingFace cache — mount a PVC here for persistent model weights
ENV HF_HOME=/opt/app-root/src/.cache/huggingface
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# CUDA runtime
ENV CUDA_HOME=/usr/local/cuda
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ---------- OpenShift compatibility ----------
# Create writable cache directory; set group-0 permissions for arbitrary UID
RUN mkdir -p /opt/app-root/src/.cache/huggingface \
    && chgrp -R 0 /opt/app-root \
    && chmod -R g=u /opt/app-root

EXPOSE 8000

USER 1001

# Use shell form so environment variables are expanded at runtime
CMD exec python3 -m tokenspeed.cli serve \
    --model ${TOKENSPEED_MODEL} \
    --host ${TOKENSPEED_HOST} \
    --port ${TOKENSPEED_PORT}
