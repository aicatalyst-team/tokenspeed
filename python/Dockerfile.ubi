# --------------------------------------------------------------------------
# TokenSpeed — GPU-accelerated LLM inference engine
# Single-stage Dockerfile for OpenShift (CUDA runtime + UBI9)
# --------------------------------------------------------------------------
# Build context: repo root (/workspace/tokenspeed)
# Build command:  podman build -f python/Dockerfile.ubi .
# --------------------------------------------------------------------------
#
# Previous build failed: builder pod was OOM-killed / evicted due to resource
# pressure during a multi-stage build that installed PyTorch + all deps twice
# (once in builder, once copied to runtime).
#
# Fixes applied:
#   1. Single-stage build — eliminates duplicate storage of large packages
#      and reduces peak disk usage by ~50%.
#   2. Install torch first in its own layer with aggressive cleanup, then
#      install remaining deps — avoids simultaneous peak memory from
#      resolving the full dependency graph at once.
#   3. PIP_NO_CACHE_DIR=1 globally to prevent pip cache accumulation.
#   4. Skip triton explicit install (bundled with torch).
#   5. Removed compiler toolchain from final image (gcc, devel headers) —
#      only install for the pip step, then remove.
#   6. Use --no-build-isolation for tokenspeed itself to avoid pip creating
#      a redundant build environment.
# --------------------------------------------------------------------------

FROM nvcr.io/nvidia/cuda:12.6.3-runtime-ubi9

USER 0

# ---------- Global pip config ----------
ENV PIP_NO_CACHE_DIR=1

# ---------- System dependencies ----------
# Install Python 3.12 + minimal build tools needed for some pip packages.
# Compilers will be removed after pip install to shrink the image.
RUN dnf install -y \
        python3.12 \
        python3.12-pip \
        python3.12-devel \
        gcc \
        gcc-c++ \
        git \
        libibverbs \
        librdmacm \
    && dnf clean all \
    && alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && alternatives --install /usr/bin/python  python  /usr/bin/python3.12 1

RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

WORKDIR /opt/app-root/src

# ---------- Step 1: Install PyTorch (largest dep, ~2 GB) ----------
# Isolated so pip only resolves torch + torchvision; less peak memory.
RUN python3 -m pip install --no-cache-dir \
        "torch==2.11.0" \
        torchvision \
        --extra-index-url https://download.pytorch.org/whl/cu126 \
    && rm -rf /tmp/pip-* /root/.cache

# ---------- Step 2: Install remaining application dependencies ----------
# These are the deps from pyproject.toml minus torch/torchvision (already installed).
RUN python3 -m pip install --no-cache-dir \
        aiohttp \
        compressed-tensors \
        dill \
        einops \
        fastapi \
        hf_transfer \
        huggingface_hub \
        modelscope \
        msgspec \
        ninja \
        numpy \
        nvidia-cutlass-dsl \
        nvtx \
        "openai==2.33.0" \
        openai-harmony \
        orjson \
        packaging \
        partial-json-parser \
        peft \
        pillow \
        prometheus-client \
        psutil \
        pybase64 \
        pybind11 \
        pydantic \
        py-spy \
        python-multipart \
        pyzmq \
        requests \
        setproctitle \
        tiktoken \
        tqdm \
        "transformers==5.6.2" \
        uv \
        uvicorn \
        uvloop \
        viztracer \
        "xgrammar==0.1.33" \
    && rm -rf /tmp/pip-* /root/.cache

# ---------- Step 3: Install the tokenspeed package ----------
COPY python/pyproject.toml python/LICENSE python/THIRDPARTYNOTICES ./python/
COPY python/tokenspeed ./python/tokenspeed

RUN cd python \
    && python3 -m pip install --no-cache-dir --no-deps --no-build-isolation . \
    && rm -rf /tmp/pip-* /root/.cache

# ---------- Step 4: Remove build-only packages to reduce image size ----------
RUN dnf remove -y \
        python3.12-devel \
        gcc \
        gcc-c++ \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# ---------- Verify critical imports ----------
RUN python3 -c "import uvicorn; import fastapi; print('Server deps OK')" \
    && python3 -c "from tokenspeed.version import __version__; print(f'TokenSpeed v{__version__}')"

# ---------- Environment variables ----------
# HF_TOKEN must be injected at runtime via K8s Secret / ConfigMap
ENV HF_TOKEN=""
ENV TOKENSPEED_MODEL=meta-llama/Llama-3.2-1B-Instruct
ENV TOKENSPEED_HOST=0.0.0.0
ENV TOKENSPEED_PORT=8000

# HuggingFace cache — mount a PVC here for persistent model weights
ENV HF_HOME=/opt/app-root/src/.cache/huggingface
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# CUDA runtime
ENV CUDA_HOME=/usr/local/cuda
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ---------- OpenShift compatibility ----------
# Create writable cache directory; set group-0 permissions for arbitrary UID
RUN mkdir -p /opt/app-root/src/.cache/huggingface \
    && chgrp -R 0 /opt/app-root \
    && chmod -R g=u /opt/app-root

EXPOSE 8000

USER 1001

# Use shell form so environment variables are expanded at runtime
CMD exec python3 -m tokenspeed.cli serve \
    --model ${TOKENSPEED_MODEL} \
    --host ${TOKENSPEED_HOST} \
    --port ${TOKENSPEED_PORT}
