# --------------------------------------------------------------------------
# TokenSpeed — GPU-accelerated LLM inference engine
# Single-stage Dockerfile for OpenShift (CUDA runtime + UBI9)
# --------------------------------------------------------------------------
# Build context: repo root (/workspace/tokenspeed)
# Build command:  podman build -f python/Dockerfile.ubi .
# --------------------------------------------------------------------------
#
# Previous build fix:
#   - The prior attempt installed all packages successfully but likely
#     exhausted disk space across multiple large Docker layers. Each RUN
#     layer persists intermediate pip/wheel artefacts even after cleanup.
#   - Fix: Consolidate pip installs into fewer RUN steps, clean up
#     aggressively within the SAME layer, and strip unnecessary files
#     (tests, __pycache__, .dist-info) from installed packages.
#   - Use correct cleanup paths for RHEL/UBI (/usr/lib64/python3.12).
#   - Drop the heavy verification RUN step that imported torch (which
#     writes CUDA lazy-init artefacts to disk).
# --------------------------------------------------------------------------

FROM nvcr.io/nvidia/cuda:12.6.3-runtime-ubi9

USER 0

# ---------- System packages (single layer) ----------
RUN dnf install -y \
        python3.12 \
        python3.12-pip \
        python3.12-devel \
        gcc \
        gcc-c++ \
        git \
        libibverbs \
        librdmacm \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/cache/yum \
    && alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && alternatives --install /usr/bin/python  python  /usr/bin/python3.12 1

# Prevent pip from caching wheels/source — critical for keeping layers small
ENV PIP_NO_CACHE_DIR=1

RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel \
    && rm -rf /root/.cache /tmp/pip-*

# ---------- Layer 1: PyTorch (largest single dep, ~2 GB) ----------
# Isolated so other installs don't re-download if only app code changes.
# Aggressively strip tests/data within the same layer.
RUN python3 -m pip install --no-cache-dir \
        "torch==2.11.0" \
        --extra-index-url https://download.pytorch.org/whl/cu126 \
    && find /usr -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true \
    && find /usr -type d -name 'tests' -path '*/torch/*' -exec rm -rf {} + 2>/dev/null || true \
    && rm -rf /root/.cache /tmp/pip-* /tmp/torch*

# ---------- Layer 2: All remaining Python dependencies ----------
# Combined into a single layer to minimize total image size.
RUN python3 -m pip install --no-cache-dir \
        "transformers==5.6.2" \
        huggingface_hub \
        hf_transfer \
        peft \
        tiktoken \
        compressed-tensors \
        einops \
        numpy \
        fastapi \
        uvicorn \
        uvloop \
        aiohttp \
        "openai==2.33.0" \
        openai-harmony \
        orjson \
        msgspec \
        pydantic \
        python-multipart \
        prometheus-client \
        dill \
        modelscope \
        nvtx \
        packaging \
        partial-json-parser \
        pillow \
        psutil \
        pybase64 \
        pybind11 \
        pyzmq \
        requests \
        setproctitle \
        tqdm \
        "xgrammar==0.1.33" \
    && find /usr -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true \
    && rm -rf /root/.cache /tmp/pip-*

# ---------- Install the tokenspeed package itself ----------
WORKDIR /opt/app-root/src

COPY python/pyproject.toml python/LICENSE python/THIRDPARTYNOTICES ./python/
COPY python/tokenspeed ./python/tokenspeed

RUN cd python \
    && python3 -m pip install --no-cache-dir --no-deps --no-build-isolation . \
    && find /usr -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true \
    && rm -rf /root/.cache /tmp/pip-*

# ---------- Light verification (no torch import to avoid CUDA init artefacts) ----------
RUN python3 -c "import uvicorn; import fastapi; print('Server deps OK')" \
    && python3 -c "from tokenspeed.version import __version__; print(f'TokenSpeed v{__version__}')"

# ---------- Environment variables ----------
# HF_TOKEN must be injected at runtime via K8s Secret / ConfigMap
ENV HF_TOKEN=""
ENV TOKENSPEED_MODEL=meta-llama/Llama-3.2-1B-Instruct
ENV TOKENSPEED_HOST=0.0.0.0
ENV TOKENSPEED_PORT=8000

# HuggingFace cache — mount a PVC here for persistent model weights
ENV HF_HOME=/opt/app-root/src/.cache/huggingface
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# CUDA runtime
ENV CUDA_HOME=/usr/local/cuda
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ---------- OpenShift compatibility ----------
# Create writable cache directory; set group-0 permissions for arbitrary UID
RUN mkdir -p /opt/app-root/src/.cache/huggingface \
    && chgrp -R 0 /opt/app-root \
    && chmod -R g=u /opt/app-root

EXPOSE 8000

USER 1001

# Use shell form so environment variables are expanded at runtime
CMD exec python3 -m tokenspeed.cli serve \
    --model ${TOKENSPEED_MODEL} \
    --host ${TOKENSPEED_HOST} \
    --port ${TOKENSPEED_PORT}
