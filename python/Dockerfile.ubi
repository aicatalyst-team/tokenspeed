# --------------------------------------------------------------------------
# TokenSpeed — GPU-accelerated LLM inference engine
# Single-stage Dockerfile for OpenShift (CUDA runtime + UBI9)
# --------------------------------------------------------------------------
# Build context: repo root (/workspace/tokenspeed)
# Build command:  podman build -f python/Dockerfile.ubi .
# --------------------------------------------------------------------------
#
# This build uses the CUDA *runtime* image (no devel toolkit) and installs
# the core tokenspeed Python package only — no native C/CUDA kernel
# extensions (tokenspeed-kernel, tokenspeed-mla, tokenspeed-scheduler).
# The server starts with pure-Python / Triton attention backends.
#
# Previous build fix: torch + all deps installed in a single layer caused
# OOM during pip resolution/download. Now heavy packages are installed in
# separate layers to cap peak memory and benefit from layer caching.
# --------------------------------------------------------------------------

FROM nvcr.io/nvidia/cuda:12.6.3-runtime-ubi9

USER 0

# ---------- System dependencies ----------
RUN dnf install -y \
        python3.12 \
        python3.12-pip \
        python3.12-devel \
        gcc \
        gcc-c++ \
        git \
        libibverbs \
        librdmacm \
    && dnf clean all \
    && alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && alternatives --install /usr/bin/python  python  /usr/bin/python3.12 1

# Upgrade pip / setuptools — keep pip itself cached, it's tiny
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

WORKDIR /opt/app-root/src

# ---------- Install heavy Python deps in isolated layers ----------
# Each RUN is a separate layer so (a) peak memory per step is bounded
# and (b) successfully installed layers are cached across rebuilds.

# Layer 1 — PyTorch (≈3 GB CUDA wheels)
# --extra-index-url keeps PyPI available for secondary deps (sympy, etc.)
RUN pip install --no-cache-dir \
        "torch==2.11.0" \
        --extra-index-url https://download.pytorch.org/whl/cu126

# Layer 2 — torchvision (pulls further CUDA libs; install separately
#           to avoid combining with the main dep resolution pass)
RUN pip install --no-cache-dir torchvision \
        --extra-index-url https://download.pytorch.org/whl/cu126

# Layer 3 — transformers and its tokeniser dependency (tiktoken compiles
#           C extensions, keep in its own layer)
RUN pip install --no-cache-dir \
        "transformers==5.6.2" \
        tiktoken

# Layer 4 — networking / server deps (lightweight)
RUN pip install --no-cache-dir \
        fastapi \
        uvicorn \
        uvloop \
        aiohttp \
        python-multipart \
        orjson \
        msgspec \
        pyzmq \
        prometheus-client \
        pydantic

# Layer 5 — remaining non-trivial deps
RUN pip install --no-cache-dir \
        compressed-tensors \
        dill \
        einops \
        hf_transfer \
        huggingface_hub \
        modelscope \
        ninja \
        numpy \
        "openai==2.33.0" \
        openai-harmony \
        packaging \
        partial-json-parser \
        peft \
        pillow \
        psutil \
        pybase64 \
        pybind11 \
        py-spy \
        requests \
        setproctitle \
        tqdm \
        uv \
        viztracer

# Layer 6 — CUDA-specific Python packages (may pull additional native libs)
RUN pip install --no-cache-dir \
        nvidia-cutlass-dsl \
        nvtx \
        "xgrammar==0.1.33" \
        triton

# ---------- Copy and install the tokenspeed package itself ----------
# All heavy deps are already installed; this step only links the package.
COPY python/pyproject.toml python/LICENSE python/THIRDPARTYNOTICES /opt/app-root/src/python/
COPY python/tokenspeed /opt/app-root/src/python/tokenspeed

RUN cd /opt/app-root/src/python \
    && pip install --no-cache-dir --no-deps . --no-build-isolation

# ---------- Verify key imports ----------
RUN python3 -c "import uvicorn; import fastapi; print('Server deps OK')"
RUN python3 -c "from tokenspeed.version import __version__; print(f'TokenSpeed v{__version__}')"

# ---------- Environment variables ----------
# HF_TOKEN must be injected at runtime via K8s Secret / ConfigMap
ENV HF_TOKEN=""
ENV TOKENSPEED_MODEL=meta-llama/Llama-3.2-1B-Instruct
ENV TOKENSPEED_HOST=0.0.0.0
ENV TOKENSPEED_PORT=8000

# HuggingFace cache — mount a PVC here for persistent model weights
ENV HF_HOME=/opt/app-root/src/.cache/huggingface
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# CUDA runtime
ENV CUDA_HOME=/usr/local/cuda
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ---------- OpenShift compatibility ----------
# Create writable cache directory; set group-0 permissions for arbitrary UID
RUN mkdir -p /opt/app-root/src/.cache/huggingface \
    && chgrp -R 0 /opt/app-root \
    && chmod -R g=u /opt/app-root

EXPOSE 8000

USER 1001

# Use shell form so environment variables are expanded at runtime
CMD exec python3 -m tokenspeed.cli serve \
    --model ${TOKENSPEED_MODEL} \
    --host ${TOKENSPEED_HOST} \
    --port ${TOKENSPEED_PORT}
