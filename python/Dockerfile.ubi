# --------------------------------------------------------------------------
# TokenSpeed — GPU-accelerated LLM inference engine
# Multi-stage Dockerfile for OpenShift (CUDA runtime + UBI9)
# --------------------------------------------------------------------------
# Build context: repo root (/workspace/tokenspeed)
# Build command:  podman build -f python/Dockerfile.ubi .
# --------------------------------------------------------------------------
#
# Previous build failed: builder pod OOM-killed / evicted due to resource
# pressure when installing PyTorch + all deps in a single-stage image
# (large intermediate layers exhausted ephemeral storage).
#
# Fixes applied:
#   1. Multi-stage build: heavy compile/install in builder, copy only the
#      installed Python site-packages to a slim CUDA runtime image. This
#      avoids storing compiler toolchain + pip cache in any final layer.
#   2. Single consolidated pip install with --no-compile --no-cache-dir
#      to minimise peak disk and memory usage.
#   3. Removed dev-only packages (viztracer, py-spy, uv) to reduce
#      download/install footprint.
#   4. squash cleanup in builder to remove every temp artifact before COPY.
# --------------------------------------------------------------------------

# ========================== STAGE 1: Builder ==============================
FROM nvcr.io/nvidia/cuda:12.6.3-devel-ubi9 AS builder

USER 0

ENV PIP_NO_CACHE_DIR=1 \
    PIP_NO_COMPILE=1

# Install Python 3.12 + build essentials
RUN dnf install -y \
        python3.12 \
        python3.12-pip \
        python3.12-devel \
        gcc \
        gcc-c++ \
        git \
    && dnf clean all \
    && rm -rf /var/cache/dnf \
    && alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && alternatives --install /usr/bin/python  python  /usr/bin/python3.12 1

# Create a virtual-env so we can copy it cleanly to the runtime stage
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# ---------- Install PyTorch first (largest dep, ~2 GB) ----------
# Isolated layer so pip only resolves torch + torchvision; less peak memory.
RUN pip install --no-cache-dir \
        "torch==2.11.0" \
        torchvision \
        --extra-index-url https://download.pytorch.org/whl/cu126 \
    && find /opt/venv -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true \
    && rm -rf /tmp/pip-*

# ---------- Install remaining application deps ----------
# All deps from pyproject.toml minus torch/torchvision (already installed)
# and minus dev-only tools (viztracer, py-spy, uv).
RUN pip install --no-cache-dir \
        aiohttp \
        compressed-tensors \
        dill \
        einops \
        fastapi \
        hf_transfer \
        huggingface_hub \
        modelscope \
        msgspec \
        ninja \
        numpy \
        nvidia-cutlass-dsl \
        nvtx \
        "openai==2.33.0" \
        openai-harmony \
        orjson \
        packaging \
        partial-json-parser \
        peft \
        pillow \
        prometheus-client \
        psutil \
        pybase64 \
        pybind11 \
        pydantic \
        python-multipart \
        pyzmq \
        requests \
        setproctitle \
        tiktoken \
        tqdm \
        "transformers==5.6.2" \
        uvicorn \
        uvloop \
        "xgrammar==0.1.33" \
    && find /opt/venv -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true \
    && rm -rf /tmp/pip-*

# ---------- Install the tokenspeed package itself ----------
WORKDIR /opt/build
COPY python/pyproject.toml python/LICENSE python/THIRDPARTYNOTICES ./python/
COPY python/tokenspeed ./python/tokenspeed

RUN cd python \
    && pip install --no-cache-dir --no-deps --no-build-isolation . \
    && find /opt/venv -type d -name '__pycache__' -exec rm -rf {} + 2>/dev/null || true \
    && rm -rf /tmp/pip-* /opt/build

# ========================== STAGE 2: Runtime ==============================
FROM nvcr.io/nvidia/cuda:12.6.3-runtime-ubi9

USER 0

# Minimal runtime dependencies — Python 3.12, network libs
RUN dnf install -y \
        python3.12 \
        libibverbs \
        librdmacm \
    && dnf clean all \
    && rm -rf /var/cache/dnf \
    && alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && alternatives --install /usr/bin/python  python  /usr/bin/python3.12 1

# Copy the fully-built virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

WORKDIR /opt/app-root/src

# ---------- Verify critical imports ----------
RUN python3 -c "import uvicorn; import fastapi; print('Server deps OK')" \
    && python3 -c "from tokenspeed.version import __version__; print(f'TokenSpeed v{__version__}')"

# ---------- Environment variables ----------
# HF_TOKEN must be injected at runtime via K8s Secret / ConfigMap
ENV HF_TOKEN=""
ENV TOKENSPEED_MODEL=meta-llama/Llama-3.2-1B-Instruct
ENV TOKENSPEED_HOST=0.0.0.0
ENV TOKENSPEED_PORT=8000

# HuggingFace cache — mount a PVC here for persistent model weights
ENV HF_HOME=/opt/app-root/src/.cache/huggingface
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# CUDA runtime
ENV CUDA_HOME=/usr/local/cuda
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ---------- OpenShift compatibility ----------
# Create writable cache directory; set group-0 permissions for arbitrary UID
RUN mkdir -p /opt/app-root/src/.cache/huggingface \
    && chgrp -R 0 /opt/app-root \
    && chmod -R g=u /opt/app-root

EXPOSE 8000

USER 1001

# Use shell form so environment variables are expanded at runtime
CMD exec python3 -m tokenspeed.cli serve \
    --model ${TOKENSPEED_MODEL} \
    --host ${TOKENSPEED_HOST} \
    --port ${TOKENSPEED_PORT}
