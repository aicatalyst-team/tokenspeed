# --------------------------------------------------------------------------
# TokenSpeed — GPU-accelerated LLM inference engine
# Single-stage Dockerfile for OpenShift (CUDA runtime + UBI9)
# --------------------------------------------------------------------------
# Build context: repo root (/workspace/tokenspeed)
# Build command:  podman build -f python/Dockerfile.ubi .
# --------------------------------------------------------------------------
#
# Previous build failed due to infrastructure — build pod evicted (symlink
# resolution error on pod log path, typically caused by OOM / disk pressure).
#
# Fixes applied:
#   1. Consolidated pip install into fewer, larger layers to reduce total
#      number of intermediate layers and cumulative disk overhead.
#   2. Combined torchvision install with other deps (was separate layer).
#   3. Reduced total layer count from 7 pip layers → 2 pip layers.
#   4. Added PIP_NO_CACHE_DIR=1 globally to prevent cache accumulation.
#   5. Clean up pip temp/build artifacts after each install step.
# --------------------------------------------------------------------------

FROM nvcr.io/nvidia/cuda:12.6.3-runtime-ubi9

USER 0

# ---------- System dependencies ----------
RUN dnf install -y \
        python3.12 \
        python3.12-pip \
        python3.12-devel \
        gcc \
        gcc-c++ \
        git \
        libibverbs \
        librdmacm \
    && dnf clean all \
    && alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && alternatives --install /usr/bin/python  python  /usr/bin/python3.12 1

RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

# Ensure pip never writes cache (belt-and-suspenders with --no-cache-dir)
ENV PIP_NO_CACHE_DIR=1

WORKDIR /opt/app-root/src

# ---------- Layer 1: PyTorch + torchvision (largest deps, ~3 GB) ----------
# Isolated so this layer is cached across rebuilds of application code.
RUN pip install --no-cache-dir \
        "torch==2.11.0" \
        torchvision \
        --extra-index-url https://download.pytorch.org/whl/cu126 \
    && rm -rf /tmp/pip-* /root/.cache

# ---------- Layer 2: All remaining Python dependencies ------------------
# Single layer to minimise intermediate storage pressure.
RUN pip install --no-cache-dir \
        aiohttp \
        compressed-tensors \
        dill \
        einops \
        fastapi \
        hf_transfer \
        huggingface_hub \
        modelscope \
        msgspec \
        ninja \
        numpy \
        nvidia-cutlass-dsl \
        nvtx \
        "openai==2.33.0" \
        openai-harmony \
        orjson \
        packaging \
        partial-json-parser \
        peft \
        pillow \
        prometheus-client \
        psutil \
        pybase64 \
        pybind11 \
        pydantic \
        py-spy \
        python-multipart \
        pyzmq \
        requests \
        setproctitle \
        tiktoken \
        tqdm \
        "transformers==5.6.2" \
        triton \
        uv \
        uvicorn \
        uvloop \
        viztracer \
        "xgrammar==0.1.33" \
    && rm -rf /tmp/pip-* /root/.cache

# ---------- Copy and install the tokenspeed package itself ----------
COPY python/pyproject.toml python/LICENSE python/THIRDPARTYNOTICES /opt/app-root/src/python/
COPY python/tokenspeed /opt/app-root/src/python/tokenspeed

RUN cd /opt/app-root/src/python \
    && pip install --no-cache-dir --no-deps --no-build-isolation . \
    && rm -rf /tmp/pip-* /root/.cache

# ---------- Verify key imports ----------
RUN python3 -c "import uvicorn; import fastapi; print('Server deps OK')" \
    && python3 -c "from tokenspeed.version import __version__; print(f'TokenSpeed v{__version__}')"

# ---------- Environment variables ----------
# HF_TOKEN must be injected at runtime via K8s Secret / ConfigMap
ENV HF_TOKEN=""
ENV TOKENSPEED_MODEL=meta-llama/Llama-3.2-1B-Instruct
ENV TOKENSPEED_HOST=0.0.0.0
ENV TOKENSPEED_PORT=8000

# HuggingFace cache — mount a PVC here for persistent model weights
ENV HF_HOME=/opt/app-root/src/.cache/huggingface
ENV HF_HUB_ENABLE_HF_TRANSFER=1

# CUDA runtime
ENV CUDA_HOME=/usr/local/cuda
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ---------- OpenShift compatibility ----------
# Create writable cache directory; set group-0 permissions for arbitrary UID
RUN mkdir -p /opt/app-root/src/.cache/huggingface \
    && chgrp -R 0 /opt/app-root \
    && chmod -R g=u /opt/app-root

EXPOSE 8000

USER 1001

# Use shell form so environment variables are expanded at runtime
CMD exec python3 -m tokenspeed.cli serve \
    --model ${TOKENSPEED_MODEL} \
    --host ${TOKENSPEED_HOST} \
    --port ${TOKENSPEED_PORT}
